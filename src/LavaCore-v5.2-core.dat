-- PROJECT LAVACORE: POTATO ASCENSION v5.2
-- Client-side cosmetic optimization

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local TEXTURE_HIDE_DISTANCE = 1400
local TEXTURE_RESTORE_DISTANCE = 1100
local TEXTURES_PER_TICK = 32
local EFFECTS_PER_TICK = 32

-- Progressive visual processing ("soft chunk loading")
local ENABLE_PROGRESSIVE_PROCESSING = true
local VISUAL_QUEUE_PER_TICK = 24
local VISUAL_QUEUE_MAX = 1500

local DISABLE_PARTICLES = true
local DISABLE_TRAILS = true
local DISABLE_BEAMS = true
local DISABLE_SMOKE = true
local DISABLE_FIRE = true
local DISABLE_SPARKLES = true
local DISABLE_HIGHLIGHTS = true
local DISABLE_DYNAMIC_LIGHTS = true
local DISABLE_POST_EFFECTS = true
local DISABLE_ATMOSPHERE = true
local DISABLE_CLOUDS = true
local DISABLE_GLOBAL_SHADOWS = true
local DISABLE_TERRAIN_DECORATION = true
local REDUCE_WATER = true

local ENABLE_NAMED_VFX_CULL = true
local ENABLE_GUI_VFX_CULL = true
local ENABLE_CAMERA_EFFECT_CULL = true

-- FPS counter
local gui = Instance.new("ScreenGui")
gui.Name = "FPSCounter"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = PlayerGui

local text = Instance.new("TextLabel")
text.Size = UDim2.fromOffset(65, 18)
text.Position = UDim2.new(1, -73, 0, 8)
text.BackgroundTransparency = 1
text.TextTransparency = 0
text.TextColor3 = Color3.fromRGB(255, 100, 20)
text.TextStrokeTransparency = 0.25
text.TextStrokeColor3 = Color3.fromRGB(40, 0, 0)
text.Font = Enum.Font.Gotham
text.TextSize = 12
text.TextXAlignment = Enum.TextXAlignment.Right
text.Text = "FPS: --"
text.Parent = gui

local frames, elapsed, lavaTime = 0, 0, 0

RunService.RenderStepped:Connect(function(dt)
    frames += 1
    elapsed += dt
    lavaTime += dt

    local wave1 = (math.sin(lavaTime * 2.5) + 1) / 2
    local wave2 = (math.sin(lavaTime * 4.0 + 1.5) + 1) / 2

    local darkRed = Color3.fromRGB(180, 20, 5)
    local orange = Color3.fromRGB(255, 90, 10)
    local yellow = Color3.fromRGB(255, 190, 30)

    local color = darkRed:Lerp(orange, wave1)
    color = color:Lerp(yellow, wave2 * 0.35)
    text.TextColor3 = color

    if elapsed >= 0.5 then
        text.Text = "FPS: " .. math.floor(frames / elapsed + 0.5)
        frames, elapsed = 0, 0
    end
end)

local textures, effects, atmospheres = {}, {}, {}
local trackedTextures = setmetatable({}, {__mode = "k"})
local trackedEffects = setmetatable({}, {__mode = "k"})
local trackedAtmospheres = setmetatable({}, {__mode = "k"})
local originalTransparency = setmetatable({}, {__mode = "k"})

local visualQueue = {}
local queueHead = 1
local queuedObjects = setmetatable({}, {__mode = "k"})

local function safeSet(object, property, value)
    pcall(function() object[property] = value end)
end

local vfxKeywords = {
    "effect","effects","vfx","particlefx","aura","glow","burst","flash",
    "pulse","spark","swoosh","slash","impact","explosion","magic"
}
local riftKeywords = {
    "rifteffect","riftvfx","riftfx","riftglow","riftburst","riftorb","riftportal"
}
local questKeywords = {
    "questeffect","questvfx","rewardeffect","rewardvfx","rewardfx",
    "claimreward","collecteffect","collectvfx","pickupvfx","pickupfx",
    "celebration","completioneffect"
}

local function containsAny(name, list)
    for _, keyword in ipairs(list) do
        if string.find(name, keyword, 1, true) then return true end
    end
    return false
end

local function nameLooksLikeVFX(instance)
    local name = string.lower(instance.Name or "")
    return containsAny(name, vfxKeywords)
        or containsAny(name, riftKeywords)
        or containsAny(name, questKeywords)
end

local function hasVFXAncestor(instance)
    local parent, depth = instance.Parent, 0
    while parent and depth < 8 do
        if nameLooksLikeVFX(parent) then return true end
        parent, depth = parent.Parent, depth + 1
    end
    return false
end

local function trackTexture(object)
    if trackedTextures[object] then return end
    if object:IsA("Decal") or object:IsA("Texture") then
        trackedTextures[object] = true
        originalTransparency[object] = object.Transparency
        table.insert(textures, object)
    end
end

local function trackEffect(object)
    if trackedEffects[object] then return end
    local class = object.ClassName
    if class == "ParticleEmitter" or class == "Trail" or class == "Beam"
        or class == "Smoke" or class == "Fire" or class == "Sparkles"
        or class == "Highlight" or class == "PointLight" or class == "SpotLight"
        or class == "SurfaceLight" or object:IsA("PostEffect")
        or class == "Clouds" or class == "SelectionBox" then
        trackedEffects[object] = true
        table.insert(effects, object)
    end
end

local function trackAtmosphere(object)
    if object:IsA("Atmosphere") and not trackedAtmospheres[object] then
        trackedAtmospheres[object] = true
        table.insert(atmospheres, object)
    end
end

local function killVisualEffect(object)
    local class = object.ClassName

    if class == "ParticleEmitter" and DISABLE_PARTICLES then
        safeSet(object, "Enabled", false)
        pcall(function() object:Clear() end)
    elseif class == "Trail" and DISABLE_TRAILS then
        safeSet(object, "Enabled", false)
    elseif class == "Beam" and DISABLE_BEAMS then
        safeSet(object, "Enabled", false)
    elseif class == "Smoke" and DISABLE_SMOKE then
        safeSet(object, "Enabled", false)
    elseif class == "Fire" and DISABLE_FIRE then
        safeSet(object, "Enabled", false)
    elseif class == "Sparkles" and DISABLE_SPARKLES then
        safeSet(object, "Enabled", false)
    elseif class == "Highlight" and DISABLE_HIGHLIGHTS then
        safeSet(object, "Enabled", false)
    elseif (class == "PointLight" or class == "SpotLight" or class == "SurfaceLight")
        and DISABLE_DYNAMIC_LIGHTS then
        safeSet(object, "Enabled", false)
        safeSet(object, "Shadows", false)
    elseif object:IsA("PostEffect") and DISABLE_POST_EFFECTS then
        safeSet(object, "Enabled", false)
    elseif class == "Atmosphere" and DISABLE_ATMOSPHERE then
        safeSet(object, "Density", 0)
        safeSet(object, "Haze", 0)
        safeSet(object, "Glare", 0)
    elseif class == "Clouds" and DISABLE_CLOUDS then
        safeSet(object, "Enabled", false)
    elseif class == "SelectionBox" then
        safeSet(object, "Visible", false)
    end
end

local function cullNamedWorldVFX(object)
    if not ENABLE_NAMED_VFX_CULL then return end
    if not (nameLooksLikeVFX(object) or hasVFXAncestor(object)) then return end

    if object:IsA("BasePart") then
        if not object.CanCollide then
            safeSet(object, "LocalTransparencyModifier", 1)
        end
    elseif object:IsA("Decal") or object:IsA("Texture") then
        safeSet(object, "Transparency", 1)
    end
end

local function cullGUIVFX(object)
    if not ENABLE_GUI_VFX_CULL then return end
    if not (nameLooksLikeVFX(object) or hasVFXAncestor(object)) then return end

    if object:IsA("BillboardGui") or object:IsA("SurfaceGui") then
        safeSet(object, "Enabled", false)
    elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
        safeSet(object, "Visible", false)
    elseif object:IsA("Frame") or object:IsA("ScrollingFrame")
        or object:IsA("CanvasGroup") then
        safeSet(object, "Visible", false)
    end
end

local function enqueueVisualObject(object)
    if not ENABLE_PROGRESSIVE_PROCESSING then
        processObject(object)
        return
    end

    if not object or not object.Parent or queuedObjects[object] then
        return
    end

    if #visualQueue - queueHead + 1 >= VISUAL_QUEUE_MAX then
        return
    end

    visualQueue[#visualQueue + 1] = object
    queuedObjects[object] = true
end

local function processVisualQueue(budget)
    local processed = 0

    while processed < budget and queueHead <= #visualQueue do
        local object = visualQueue[queueHead]
        visualQueue[queueHead] = nil
        queueHead += 1

        if queuedObjects[object] then
            queuedObjects[object] = nil
        end

        if object and object.Parent then
            processObject(object)
        end

        processed += 1
    end

    if queueHead > 256 and queueHead > #visualQueue / 2 then
        local compacted = {}
        for i = queueHead, #visualQueue do
            compacted[#compacted + 1] = visualQueue[i]
        end
        visualQueue = compacted
        queueHead = 1
    end
end

local function processObject(object)
    if not object or not object.Parent then return end
    if object:IsA("Decal") or object:IsA("Texture") then trackTexture(object) end
    trackEffect(object)
    trackAtmosphere(object)
    killVisualEffect(object)
    cullNamedWorldVFX(object)
    cullGUIVFX(object)
end

local characterConnections = {}

local function watchCharacter(character)
    if not character or characterConnections[character] then return end

    characterConnections[character] = character.DescendantAdded:Connect(function(object)
        processObject(object)
    end)

    for _, object in ipairs(character:GetDescendants()) do
        processObject(object)
    end
end

local function watchPlayer(player)
    if player.Character then watchCharacter(player.Character) end
    player.CharacterAdded:Connect(watchCharacter)
end

for _, player in ipairs(Players:GetPlayers()) do watchPlayer(player) end
Players.PlayerAdded:Connect(watchPlayer)

PlayerGui.DescendantAdded:Connect(enqueueVisualObject)

local cameraConnection
local function watchCamera(camera)
    if cameraConnection then cameraConnection:Disconnect() end
    cameraConnection = nil
    if not camera then return end

    cameraConnection = camera.DescendantAdded:Connect(function(object)
        if ENABLE_CAMERA_EFFECT_CULL then enqueueVisualObject(object) end
    end)

    for _, object in ipairs(camera:GetDescendants()) do
        if ENABLE_CAMERA_EFFECT_CULL then enqueueVisualObject(object) end
    end
end

watchCamera(Workspace.CurrentCamera)
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    watchCamera(Workspace.CurrentCamera)
end)

Workspace.DescendantAdded:Connect(enqueueVisualObject)
Lighting.DescendantAdded:Connect(enqueueVisualObject)

local function optimizeLighting()
    if DISABLE_GLOBAL_SHADOWS then
        safeSet(Lighting, "GlobalShadows", false)
    end
end

local function optimizeTerrain()
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if not terrain then return end

    if DISABLE_TERRAIN_DECORATION then safeSet(terrain, "Decoration", false) end

    if REDUCE_WATER then
        safeSet(terrain, "WaterWaveSize", 0)
        safeSet(terrain, "WaterWaveSpeed", 0)
        safeSet(terrain, "WaterReflectance", 0)
    end
end

local function scanContainer(container)
    local objects = container:GetDescendants()
    for index, object in ipairs(objects) do
        enqueueVisualObject(object)
        if index % 64 == 0 then task.wait() end
    end
end

optimizeLighting()
optimizeTerrain()
scanContainer(Workspace)
scanContainer(Lighting)
scanContainer(PlayerGui)

if Workspace.CurrentCamera then
    scanContainer(Workspace.CurrentCamera)
end

local textureIndex = 1

local function getCameraPosition()
    local camera = Workspace.CurrentCamera
    return camera and camera.CFrame.Position
end

local function updateTextureLOD()
    local cameraPosition = getCameraPosition()
    if not cameraPosition or #textures == 0 then return end

    local hideDistanceSquared = TEXTURE_HIDE_DISTANCE * TEXTURE_HIDE_DISTANCE
    local restoreDistanceSquared = TEXTURE_RESTORE_DISTANCE * TEXTURE_RESTORE_DISTANCE

    for _ = 1, TEXTURES_PER_TICK do
        if textureIndex > #textures then textureIndex = 1 end

        local object = textures[textureIndex]
        textureIndex += 1

        if object and object.Parent then
            local position

            if object.Parent:IsA("BasePart") then
                position = object.Parent.Position
            elseif object.Parent:IsA("Attachment") and object.Parent.Parent
                and object.Parent.Parent:IsA("BasePart") then
                position = object.Parent.Parent.Position
            end

            if position then
                local distanceSquared = (position - cameraPosition).Magnitude ^ 2

                if distanceSquared >= hideDistanceSquared then
                    safeSet(object, "Transparency", 1)
                elseif distanceSquared <= restoreDistanceSquared then
                    local original = originalTransparency[object]
                    if original ~= nil then safeSet(object, "Transparency", original) end
                end
            end
        end
    end
end

local effectIndex = 1

local function enforceEffects()
    if #effects == 0 then return end

    for _ = 1, EFFECTS_PER_TICK do
        if effectIndex > #effects then effectIndex = 1 end

        local object = effects[effectIndex]
        effectIndex += 1

        if object and object.Parent then
            killVisualEffect(object)
            cullNamedWorldVFX(object)
            cullGUIVFX(object)
        end
    end
end

local atmosphereIndex = 1

local function enforceAtmosphere()
    if not DISABLE_ATMOSPHERE or #atmospheres == 0 then return end

    for _ = 1, math.min(8, #atmospheres) do
        if atmosphereIndex > #atmospheres then atmosphereIndex = 1 end

        local object = atmospheres[atmosphereIndex]
        atmosphereIndex += 1

        if object and object.Parent then
            safeSet(object, "Density", 0)
            safeSet(object, "Haze", 0)
            safeSet(object, "Glare", 0)
        end
    end
end

local maintenanceTimer = 0

RunService.Heartbeat:Connect(function(dt)
    updateTextureLOD()
    enforceEffects()
    enforceAtmosphere()

    maintenanceTimer += dt

    if maintenanceTimer >= 0.5 then
        maintenanceTimer = 0
        optimizeLighting()
        optimizeTerrain()
    end
end)

pcall(function()
    StarterGui:SetCore("SendNotification", {
        Title = "🔥 LAVACORE: POTATO ASCENSION",
        Text = "Frame optimization activated 📈",
        Duration = 5
    })
end)

print("🔥 PROJECT LAVACORE v5.2 loaded.")
print("🥔 Potato Ascension: ACTIVE")
print("📈 Batched texture LOD: ACTIVE")
print("💥 VFX/Rift/Quest culling: ACTIVE")
print("🔥 FPS counter: ACTIVE")
