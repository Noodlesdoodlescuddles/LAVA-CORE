local coreLen=19513
local function bxor(a,b)
    local result=0
    local bit=1
    while a>0 or b>0 do
        local aa=a%2
        local bb=b%2
        if aa~=bb then
            result=result+bit
        end
        a=(a-aa)/2
        b=(b-bb)/2
        bit=bit*2
    end
    return result
end

local S={}
for i=1,coreLen do
    S[i]=string.char(bxor(D[i] or 0,K[((i-1)%#K)+1]))
end

local chunk,err=loadstring(table.concat(S))
if not chunk then error(err) end
return chunk()
