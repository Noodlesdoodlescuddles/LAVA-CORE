local coreLen=19263

local function bxor(a,b)
    local result = 0
    local bit = 1
    while a > 0 or b > 0 do
        local aa = a % 2
        local bb = b % 2
        if aa ~= bb then result = result + bit end
        a = math.floor(a / 2)
        b = math.floor(b / 2)
        bit = bit * 2
    end
    return result
end

local out={}
for i,v in ipairs(D) do
    out[i]=string.char(bxor(v,K[((i-1)%#K)+1]))
end
local source=table.concat(out)
local chunk,err=loadstring(source)
if not chunk then error(err) end
return chunk()
